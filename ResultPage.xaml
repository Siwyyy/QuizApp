<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.ResultPage"
             Title="Podsumowanie"
             NavigationPage.HasBackButton="False">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
        
        <Label Text="Koniec Quizu!" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Label x:Name="ScoreLabel" 
               Text="Zdobyte punkty: 0/0" 
               FontSize="20" 
               HorizontalOptions="Center" />

        <Button Text="Wróć do menu głównego" 
                Clicked="OnBackToMenuClicked" 
                Margin="0, 30, 0, 0" />

    </VerticalStackLayout>

</ContentPage>
