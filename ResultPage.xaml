<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.ResultPage"
             Title="Podsumowanie"
             NavigationPage.HasBackButton="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
            <ColumnDefinition Width="{OnIdiom Phone=*, Default=600}" />
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
        </Grid.ColumnDefinitions>
        
        <VerticalStackLayout Grid.Column="1" Padding="30" Spacing="20" VerticalOptions="Center" HorizontalOptions="Fill">
            
            <Label Text="Koniec Quizu!" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Label x:Name="ScoreLabel" 
                   Text="Zdobyte punkty: 0/0" 
                   FontSize="20" 
                   HorizontalOptions="Center" />

            <Button Text="Wróć do menu głównego" 
                    Clicked="OnBackToMenuClicked" 
                    Margin="0, 30, 0, 0" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
