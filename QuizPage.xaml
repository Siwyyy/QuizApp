<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizApp.QuizPage"
             Title="{Binding QuizTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="30,30" Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Center">
            
            <Label x:Name="ProgressLabel" 
                   Text="Pytanie 1/10" 
                   FontSize="16" 
                   TextColor="Gray" 
                   HorizontalOptions="Center" />

            <Label x:Name="QuestionTextLabel" 
                   Text="Treść pytania?" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />

            <!-- Kontener dla dynamicznych opcji -->
            <VerticalStackLayout x:Name="OptionsContainer" Spacing="10" Margin="0, 10" />

            <Label x:Name="ExplanationLabel" 
                   IsVisible="False" 
                   FontSize="16" 
                   TextColor="DarkCyan"
                   Margin="0, 10" />

            <Button x:Name="ActionBtn" 
                    Text="Sprawdź" 
                    Clicked="OnActionClicked" 
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
